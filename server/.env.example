# Environment variables template - Copy to .env and fill in your credentials

# MongoDB Atlas Connection String
# Get from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://samruddhikhot7_db_user:YOUR_ACTUAL_PASSWORD@cluster0.pflhu60.mongodb.net/petfeeder?retryWrites=true&w=majority

# JWT Secret - Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars_here

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# MQTT Broker Configuration (for ESP32)
MQTT_BROKER=mqtt://broker.hivemq.com
# For private MQTT broker, use: mqtt://username:password@your-broker.com:1883
